# Salesforce and Conductor credentials are REQUIRED — there is no mock mode.
# An org with no credentials configured raises a clear error rather than
# serving fabricated data.
#
# ── Salesforce Dev Org ──────────────────────────────────────────────────────
SF_DEV_USERNAME=your-dev-username@doane.edu.sandbox
SF_DEV_PASSWORD=your-dev-password
SF_DEV_TOKEN=your-dev-security-token
SF_DEV_DOMAIN=test

# ── Salesforce Prod Org ──────────────────────────────────────────────────────
SF_PROD_USERNAME=your-prod-username@doane.edu
SF_PROD_PASSWORD=your-prod-password
SF_PROD_TOKEN=your-prod-security-token
SF_PROD_DOMAIN=login

# ── Salesforce Sandbox Org ────────────────────────────────────────────────────
SF_SANDBOX_USERNAME=your-sandbox-username@doane.edu.sandbox
SF_SANDBOX_PASSWORD=your-sandbox-password
SF_SANDBOX_TOKEN=your-sandbox-security-token
SF_SANDBOX_DOMAIN=test

# ── Salesforce API Version ────────────────────────────────────────────────────
# Global default (used for all orgs unless overridden per-org below).
# Set to match the highest API version your orgs support (check Setup → API).
SF_API_VERSION=59.0
# Salesforce SOAP login rejects versions 60+; this version is used only for
# initial authentication. All REST API calls use SF_API_VERSION above.
SF_SOAP_AUTH_VERSION=57.0
# Per-org overrides — uncomment and set as needed:
# SF_SANDBOX_API_VERSION=65.0
# SF_DEV_API_VERSION=65.0
# SF_PROD_API_VERSION=65.0

# ── Conductor (workflow orchestration) ───────────────────────────────────────
CONDUCTOR_URL=http://conductor:8080
CONDUCTOR_API_KEY=your-conductor-api-key

# ── PostgreSQL ────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:password@localhost:5432/sf_mission_control

# ── App ───────────────────────────────────────────────────────────────────────
SECRET_KEY=change-me-in-production
# Org selected on first visit / new session. One of: dev, prod, sandbox.
DEFAULT_ORG=dev
PORT=5000

# ── SQL Server (for Join Builder) ─────────────────────────────────────────────
SQLSERVER_CONN=DRIVER={ODBC Driver 17 for SQL Server};SERVER=your-server;DATABASE=your-db;UID=your-user;PWD=your-password

# ── DML / Trigger Guard ───────────────────────────────────────────────────────
# Max Salesforce DML calls per second (0 = unlimited).
SF_DML_RATE_LIMIT=0
# Hierarchy Custom Setting API name that holds a trigger-bypass checkbox field.
# Leave blank to disable the bypass-triggers feature.
SF_BYPASS_SETTING=
# Field on the Custom Setting that disables triggers when true.
SF_BYPASS_FIELD=Bypass_Triggers__c

# ── Anthropic API (Natural Language → SOQL) ──────────────────────────────────
# Required for the NL→SOQL feature in the SOQL Workbench tab.
# Get a key at https://console.anthropic.com — use a key scoped to this project only.
# The feature gracefully degrades (shows a placeholder) when this is blank.
# In k8s: add to the same Secret as SF credentials, reference as ANTHROPIC_API_KEY.
ANTHROPIC_API_KEY=

# ── PII / Anonymizer Service ──────────────────────────────────────────────────
# URL of your PII scrubbing service. Leave blank to run in stub mode (no data modified).
# See services/anonymizer.py for the integration point.
PII_SERVICE_URL=

# ── Migration ─────────────────────────────────────────────────────────────────
# Total records expected in the migration — drives the velocity view's
# %-complete and ETA. 0 = unknown (the view degrades gracefully).
MIGRATION_RECORD_TARGET=0

# ── Feature flags ─────────────────────────────────────────────────────────────
SCHEDULER_ENABLED=false
